# jobsweep credentials and paths.
#
# Copy to jobsweep/.env (gitignored) and fill in what you have. Every key is optional: sources whose
# keys are missing are reported by `jobsweep doctor` and skipped. Empty values count as "not set".
# Lookup order: real environment > $JOBSWEEP_HOME/.env > ./.env > jobsweep/.env > ~/.config/jobsweep/.env
#
# Claude Code expands ${VAR:-} in the repo-root .mcp.json from the SHELL environment only (not from this
# file). To hand these keys to the MCP servers too, export them before starting Claude Code:
#     set -a; . jobsweep/.env; set +a; claude
# GitHub Actions: store the same names as repository secrets (Settings > Secrets and variables > Actions).
# Never commit real values.

# --- Federal jobs: USAJOBS ---------------------------------------------------------------------------
# Free API key: request at https://developer.usajobs.gov/apirequest/ (arrives by email in minutes).
# Without both values jobsweep falls back to the free Pipeworx gateway (about 50 calls/day).
# Also used by the federal-compass MCP server.
USAJOBS_API_KEY=
# The email you registered with USAJOBS; sent as the User-Agent header.
USAJOBS_EMAIL=
# Optional Pipeworx gateway key in the form <auth_key>:<email> (https://pipeworx.io). Raises the
# free-tier quota of the USAJOBS fallback and of the pipeworx-usajobs MCP server (?_apiKey=...).
PIPEWORX_API_KEY=

# --- Adzuna (keyword search, US + UK) ------------------------------------------------------------------
# Free developer account: https://developer.adzuna.com/signup -> create an application -> app id + key.
# Free tier: about 25 calls/min, 250/day. Also used by the adzuna MCP server.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Metered sources (only run with --include-metered / include_metered=True) --------------------------
# TheirStack API key: https://app.theirstack.com (Settings > API key). Every search consumes credits.
# The theirstack MCP server can use OAuth instead of this key.
THEIRSTACK_API_KEY=
# HasData API key for Indeed listings: https://app.hasdata.com (Dashboard > API key).
# Free: 1,000 credits/month = about 100 Indeed calls. The hasdata-indeed MCP server can use OAuth instead.
HASDATA_API_KEY=
# Apify API token: https://console.apify.com/account/integrations (pay per result: hiring.cafe scraper
# about $1.15/1k, JobSpy actor, job-search actor about $2/1k, Workday monitor about $1/1k).
# Also used by the ats-jobs MCP server for search_jobs_all_companies (about $1/1k jobs).
APIFY_TOKEN=

# --- NYC Open Data (NYC Jobs feed, dataset kpav-sd4t) ----------------------------------------------------
# Optional app token, raises Socrata rate limits: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# --- Paths ------------------------------------------------------------------------------------------------
# SQLite database (default: jobsweep/var/jobsweep.db).
JOBSWEEP_DB=
# Output folder of `jobsweep export` / the static GitHub Pages board (default: jobsweep/site).
JOBSWEEP_SITE_DIR=
# Your own copy of catalog/profile.yaml (preferred locations, max years of experience, ...).
JOBSWEEP_PROFILE=
# A folder holding another .env with the variables above (checked before ./.env).
JOBSWEEP_HOME=

# --- Keys read only by optional MCP servers, not by jobsweep ----------------------------------------------
# Export these in your shell (not here) if you use the servers in integrations/claude_code_setup.sh:
#   BRAVE_API_KEY      Brave Search API key, https://api-dashboard.search.brave.com (2,000 free queries)
#   DREAMWORK_API_KEY  optional, Dreamwork account key (the server works without one)
